# ============================================================
# MUSCLUB — ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# Скопируйте этот файл в .env и заполните под свою среду:
#   cp .env.example .env
# ============================================================

# ------ ВНЕШНИЙ HTTP-ПОРТ (единственный порт, открытый на сервере) ------
HTTP_PORT=80

# ------ ДОМЕН / IP сервера ------
# Укажите реальный домен или IP-адрес сервера.
# Используется в Keycloak и Next.js для redirect URI и CORS.
# Примеры:
#   SERVER_HOST=musclub.example.com
#   SERVER_HOST=192.168.1.100
SERVER_HOST=localhost

# ------ ПРОТОКОЛ ------
# Если у вас настроен HTTPS (через внешний reverse proxy или сертификат) — укажите https
SERVER_PROTOCOL=http

# ------ KEYCLOAK ------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=musclub
KEYCLOAK_CLIENT_ID=musclub-frontend

# ------ POSTGRESQL ------
POSTGRES_DB=musclub
POSTGRES_USER=musclub
POSTGRES_PASSWORD=musclub

# ------ SPRING BOOT (backend) ------
# DeepSeek API ключ — получить на https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-CHANGE_ME_YOUR_DEEPSEEK_KEY

# Push уведомления (Web Push)
# Генерировать: npm install -g web-push && web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_YOUR_VAPID_PRIVATE_KEY

MUSCLUB_DISPLAY_TIMEZONE=Asia/Novosibirsk

# ------ NEXTAUTH ------
# Генерировать: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS

# ============================================================
# НЕ ТРОГАЙТЕ НИЖЕ — внутренние переменные, вычисляются автоматически
# ============================================================
